[Unit]
Description=Plotter Hub
After=network.target

[Service]
Type=simple
Environment=PLOTTER_MODEL=2
ExecStart=__WORKDIR__/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 80
WorkingDirectory=__WORKDIR__
User=__SERVICE_USER__
Restart=on-failure
RestartSec=3
# AmbientCapabilities grants low-port binding without running as root.
# We deliberately do NOT set CapabilityBoundingSet: the shutdown button shells
# out via `sudo`, which needs CAP_SETUID/CAP_SETGID to transition UIDs — those
# would be filtered out by a narrower bounding set.
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
