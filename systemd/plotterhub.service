[Unit]
Description=Plotter Hub
After=network.target

[Service]
Type=simple
Environment=PLOTTER_MODEL=2
ExecStart=/home/plotter/plotterhub/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 80
WorkingDirectory=/home/plotter/plotterhub
User=plotter
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
